# Cloudflare Workers Assets — Cache-Control rules
# /_next/static/* files have content-hashed filenames, safe to cache forever

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800

/favicon-*.png
  Cache-Control: public, max-age=604800

/icon-*.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/icon.svg
  Cache-Control: public, max-age=604800

